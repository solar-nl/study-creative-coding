// ============================================================================
// READABLE VERSION: Text Texture Passthrough
// Original: ../texgen/text.hlsl (10 lines)
//
// Algorithm: Simple texture sampling for pre-rendered text.
//            This shader is a passthrough that samples a text texture
//            generated by the apEx tool's text rendering system.
//
// How Text Works in apEx:
//   1. Text is rendered to a texture using system fonts (CPU-side)
//   2. This shader samples that pre-rendered texture
//   3. The result can be further processed by other texgen operations
//
// This is the simplest possible texgen shader — just sample and return.
// It exists as a separate node type to distinguish text sources in the
// material graph.
//
// Use Cases:
//   - Display rendered text in materials
//   - Text overlays and credits
//   - UI elements
//   - Dynamic text effects (when chained with other ops)
//
// Parameters:
//   Texture0 — Pre-rendered text texture
// ============================================================================

SamplerState linearSampler : register(s0);
Texture2D textTexture : register(t0);

// ============================================================================
// Pixel Shader — Sample Text Texture
// ============================================================================
float4 PixelMain(float2 texCoord : TEXCOORD0) : SV_TARGET0
{
    return textTexture.Sample(linearSampler, texCoord);
}
